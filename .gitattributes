# Los generadores de Flutter escriben estos archivos en LF incluso en Windows,
# mientras que core.autocrlf=true espera CRLF: sin declararlo, git los deja
# marcados como modificados en cada build aunque el contenido no cambie.
linux/flutter/generated_* text eol=lf
windows/flutter/generated_* text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
