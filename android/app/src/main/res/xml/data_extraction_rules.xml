<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de aquí sale del dispositivo: la base de datos con las listas y los
     tokens de sesión viven en estas carpetas. `allowBackup="false"` ya cubre a
     los Android antiguos, pero en Android 12+ algunas capas lo ignoran para el
     traspaso entre móviles, y cualquier modo sin reglas propias queda activo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
